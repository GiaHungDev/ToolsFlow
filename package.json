{
  "name": "harumi-ai",
  "version": "0.1.2",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "setup:ext": "cd src/lib/veo3-extension && npm install",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "dev:electron": "concurrently \"next dev\" \"wait-on tcp:3000 && cross-env NODE_ENV=development electron .\"",
    "build:electron": "next build && node scripts/copy-standalone.js && electron-builder"
  },
  "build": {
    "afterPack": "./scripts/afterPack.js",
    "appId": "com.vfast.harumiai",
    "productName": "Harumi AI",
    "directories": {
      "output": "dist_electron"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "GiaHungDev",
        "repo": "ToolsFlow"
      }
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": ".next/standalone",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "electron",
        "to": "electron",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "dependencies": {
    "@google/genai": "^1.33.0",
    "@hookform/resolvers": "^5.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@reduxjs/toolkit": "^2.8.2",
    "@tanstack/react-table": "^8.21.3",
    "@types/mime": "^3.0.4",
    "axios": "^1.11.0",
    "class-variance-authority": "^0.7.1",
    "cloakbrowser": "^0.3.31",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.18",
    "electron-updater": "^6.8.3",
    "express": "^5.2.1",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.525.0",
    "mime": "^4.1.0",
    "next": "14.2.30",
    "next-themes": "^0.4.6",
    "otpauth": "^9.5.1",
    "playwright-core": "^1.60.0",
    "puppeteer-core": "^24.43.1",
    "puppeteer-real-browser": "^1.4.4",
    "rc-table": "^7.51.1",
    "react": "^18.2.0",
    "react-day-picker": "^9.9.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.61.1",
    "react-player": "^3.3.2",
    "react-redux": "^8.1.3",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "^0.18.5",
    "zod": "^4.0.10"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/react-redux": "^7.1.34",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.7.0",
    "electron-builder": "^26.8.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.30",
    "fs-extra": "^11.3.5",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "wait-on": "^9.0.10"
  }
}
